# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# O .env e lido automaticamente pela aplicacao (spring.config.import) e nunca deve ser commitado.

# --- Banco de dados (aplicacao + docker compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=SMH
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senhapostgres

# --- Containers (docker compose) ---
CONTAINER_POSTGRES_NAME=smh-db
CONTAINER_APP_NAME=smh-app
APP_PORT=8080

# --- JWT ---
# Gere um valor forte com: openssl rand -base64 48
JWT_SECRET=troque-por-um-secret-forte
JWT_ISSUER=smh

# --- Servidor CoAP (opcionais; default 5683 / smh-coap) ---
COAP_PORTA=5683
COAP_NOME_SERVIDOR=smh-coap
